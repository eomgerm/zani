# Insert these exact locations inside the existing i15a105.p.ssafy.io TLS server block.
# Do not expose the Jenkins UI, /job, /api, or any broader prefix.
location = /project/zani-dev-dispatch {
    limit_except POST {
        deny all;
    }

    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:18081;
}

# Merge request review webhook. Only the zani-mr-review job endpoint is exposed.
location = /project/zani-mr-review {
    limit_except POST {
        deny all;
    }

    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:18081;
}
